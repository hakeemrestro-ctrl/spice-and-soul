# BillDesk Static IP Adapter Environment Configuration
# Place at /etc/billdesk-adapter/adapter.env with chmod 600
BILLDESK_ENV=UAT
BILLDESK_UPSTREAM_ENABLED=false

# Non-secret application auth key ID (matches BILLDESK_ADAPTER_AUTH_KEY_ID in .env.local)
BILLDESK_ADAPTER_AUTH_KEY_ID=uat-adapter-key-1

# Shared secret: must be at least 32 UTF-8 bytes (generate using: openssl rand -hex 32)
# Must match BILLDESK_ADAPTER_AUTH_SECRET in Next.js .env.local
BILLDESK_ADAPTER_AUTH_SECRET=REPLACE_WITH_RANDOM_32_BYTE_HEX

# Private durable SQLite state file for nonces and operation IDs
BILLDESK_ADAPTER_STATE_PATH=/var/lib/billdesk-adapter/state.sqlite
