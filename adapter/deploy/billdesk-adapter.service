[Unit]
Description=BillDesk Static IP Payment Adapter (Loopback 3100)
After=network.target

[Service]
Type=simple
User=billdesk-adapter
Group=billdesk-adapter
WorkingDirectory=/opt/billdesk-adapter
EnvironmentFile=/etc/billdesk-adapter/adapter.env
ExecStart=/usr/bin/node --experimental-sqlite --import tsx adapter/billdesk/main.ts
Restart=on-failure
RestartSec=5s
UMask=0077
LimitNOFILE=65535
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
