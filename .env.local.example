NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Paytm production credentials — dashboard.paytm.com → API Keys
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=DEFAULT
PAYTM_INDUSTRY_TYPE_ID=Retail
PAYTM_CHANNEL_ID=WEB
# Public Paytm config — exposed to the client to bootstrap the SDK
NEXT_PUBLIC_PAYTM_MID=
NEXT_PUBLIC_PAYTM_HOST=securegw.paytm.in
RESEND_API_KEY=re_...
# Shared secret for Vercel cron — Vercel sends `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=generate-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Get a free key at https://unsplash.com/developers (Demo tier 50/hr, Production 5000/hr)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
# Optional
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
ADMIN_DIGEST_EMAIL=
