NEXT_PUBLIC_BILLDESK_ENABLED=false
BILLDESK_ENV=UAT
BILLDESK_MERCID=
BILLDESK_CLIENT_ID=
# BillDesk V2: server-side values supplied by BillDesk; never use NEXT_PUBLIC_ keys.
BILLDESK_KEY_ID=
BILLDESK_JWE_PASSWORD=
BILLDESK_JWS_PASSWORD=
# Set only after merchant-profile confirmation; unsupported values fail closed.
# Supported key encoding: utf8 (raw bytes; no truncation or derivation).
BILLDESK_KEY_ENCODING=
# Supported signing algorithm: HS256.
BILLDESK_JWS_ALGORITHM=
# Confirm with BillDesk: ist-calendar, epoch-seconds, or epoch-milliseconds.
BILLDESK_TIMESTAMP_FORMAT=

# BillDesk UAT adapter (server-side only; upstream remains disabled)
BILLDESK_ADAPTER_URL=
BILLDESK_ADAPTER_AUTH_KEY_ID=
BILLDESK_ADAPTER_AUTH_SECRET=
BILLDESK_UPSTREAM_ENABLED=false
# Production customer checkout stays disabled until the production merchant
# profile, adapter, database and callbacks have been approved and verified.
BILLDESK_CUSTOMER_CHECKOUT_ENABLED=false
BILLDESK_APP_ORIGIN=
# At least 32 random bytes; server-only. Used only to pseudonymously bind repeat
# anonymous checkout attempts and never sent to BillDesk or the browser.
BILLDESK_CHECKOUT_BINDING_SECRET=
BILLDESK_HOSTED_URL=
BILLDESK_HOSTED_FIELDS=
# Adapter process only: absolute path in a restricted durable state directory
BILLDESK_ADAPTER_STATE_PATH=
# Set omit-confirmed only after BillDesk confirms MAC may be omitted
BILLDESK_DEVICE_MAC_POLICY=
# Isolated UAT only. Exact HTTPS origin and allowlisted verified Supabase user IDs.
BILLDESK_UAT_APP_ORIGIN=
BILLDESK_UAT_TESTER_IDS=
# Confirm the exact hosted POST URL and exact comma-separated form field names.
BILLDESK_UAT_HOSTED_URL=
BILLDESK_UAT_HOSTED_FIELDS=
